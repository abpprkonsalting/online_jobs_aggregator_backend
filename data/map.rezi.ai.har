            "mimeType": "text/html",
            "text": "<!DOCTYPE html><html class=\"h-screen\" lang=\"en\"><head><meta charset=\"UTF-8\"><meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no\"><meta http-equiv=\"X-UA-Compatible\" content=\"ie=edge\"><title>Job Search Map – Find 3M+ Jobs Near You | Rezi</title><meta name=\"description\" content=\"Search 3M+ job listings on an interactive job map. Filter by location, industry, and role to find jobs near you — powered by Rezi.\"><link rel=\"canonical\" href=\"https://map.rezi.ai/\"><meta property=\"og:type\" content=\"website\"><meta property=\"og:url\" content=\"https://map.rezi.ai/\"><meta property=\"og:title\" content=\"Job Search Map – Find 3M+ Jobs Near You | Rezi\"><meta property=\"og:description\" content=\"Search 3M+ job listings on an interactive job map. Filter by location, industry, and role to find jobs near you — powered by Rezi.\"><meta property=\"og:site_name\" content=\"Rezi\"><meta property=\"og:image\" content=\"https://map.rezi.ai/images/JSM_Opengraph.png\"><meta name=\"twitter:card\" content=\"summary_large_image\"><meta name=\"twitter:title\" content=\"Job Search Map – Find 3M+ Jobs Near You | Rezi\"><meta name=\"twitter:description\" content=\"Search 3M+ job listings on an interactive job map. Filter by location, industry, and role to find jobs near you — powered by Rezi.\"><meta name=\"twitter:image\" content=\"https://map.rezi.ai/images/JSM_Opengraph.png\"><link rel=\"icon\" href=\"/images/icon.png\"><script type=\"application/ld+json\">{\"@context\":\"https://schema.org\",\"@graph\":[{\"@type\":\"Organization\",\"name\":\"Rezi\",\"url\":\"https://rezi.ai\",\"logo\":\"https://map.rezi.ai/images/logo.svg\"},{\"@type\":\"WebSite\",\"name\":\"Job Search Map – Find 3M+ Jobs Near You | Rezi\",\"url\":\"https://map.rezi.ai/\",\"description\":\"Search 3M+ job listings on an interactive job map. Filter by location, industry, and role to find jobs near you — powered by Rezi.\",\"potentialAction\":{\"@type\":\"SearchAction\",\"target\":{\"@type\":\"EntryPoint\",\"urlTemplate\":\"https://map.rezi.ai/?job-query={search_term_string}\"},\"query-input\":\"required name=search_term_string\"}}]}</script><meta name=\"astro-view-transitions-enabled\" content=\"true\"><meta name=\"astro-view-transitions-fallback\" content=\"animate\"><script type=\"module\" src=\"/_astro/ClientRouter.astro_astro_type_script_index_0_lang.6MByUk2W.js?dpl=6abdb848d114140008f6f950\"></script><script>(function(){const tests = [{\"id\":\"0039_maps_target_cta\",\"attr\":\"data-ab-0039-maps-target-cta\",\"buckets\":{\"control\":1,\"tailor\":1,\"score\":1}}];\nconst cookieName = \"rezi_maps_ab\";\nconst cookieDays = 365;\n\n      (function () {\n        var chars = 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789';\n        var id = null;\n        var cookies = document.cookie ? document.cookie.split('; ') : [];\n        for (var c = 0; c < cookies.length; c++) {\n          var eq = cookies[c].indexOf('=');\n          if (eq > 0 && cookies[c].slice(0, eq) === cookieName) {\n            id = decodeURIComponent(cookies[c].slice(eq + 1));\n            break;\n          }\n        }\n        if (!id) {\n          id = '';\n          for (var n = 0; n < 10; n++) {\n            id += chars.charAt(Math.floor(Math.random() * chars.length));\n          }\n          var local = location.hostname === 'localhost' || location.hostname === '127.0.0.1';\n          document.cookie = cookieName + '=' + id + '; path=/; max-age=' +\n            cookieDays * 86400 + '; SameSite=Lax' + (local ? '' : '; Secure');\n        }\n\n        function hash(input) {\n          var h = 0;\n          for (var i = 0; i < input.length; i++) {\n            h = (h * 31 + input.charCodeAt(i)) >>> 0;\n          }\n          return h;\n        }\n\n        function bucketFor(test) {\n          var names = Object.keys(test.buckets).sort();\n          var total = 0;\n          for (var i = 0; i < names.length; i++) total += test.buckets[names[i]];\n          if (!total) return names[0] || 'control';\n          var point = hash(id + ':' + test.id) % total;\n          var seen = 0;\n          for (var j = 0; j < names.length; j++) {\n            seen += test.buckets[names[j]];\n            if (point < seen) return names[j];\n          }\n          return names[names.length - 1];\n        }\n\n        var buckets = {};\n        for (var t = 0; t < tests.length; t++) {\n          buckets[tests[t].id] = bucketFor(tests[t]);\n          document.documentElement.setAttribute(tests[t].attr, buckets[tests[t].id]);\n        }\n        window.__REZI_MAPS_AB = { id: id, buckets: buckets };\n\n        if (!window.__REZI_MAPS_AB_SWAP) {\n          window.__REZI_MAPS_AB_SWAP = true;\n          document.addEventListener('astro:before-swap', function (event) {\n            for (var k = 0; k < tests.length; k++) {\n              event.newDocument.documentElement.setAttribute(tests[k].attr, buckets[tests[k].id]);\n            }\n          });\n        }\n      })();\n    })();</script><script>\n    // Preserve <html> class (e.g. dark mode) across View Transitions page swaps.\n    document.addEventListener('astro:before-swap', (e) => {\n      e.newDocument.documentElement.className =\n        document.documentElement.className;\n    });\n\n    // Prevent browser zoom (Ctrl+scroll and Ctrl+±) — breaks the map layout.\n    document.addEventListener(\n      'wheel',\n      (e) => {\n        if (e.ctrlKey) e.preventDefault();\n      },\n      { passive: false },\n    );\n\n    document.addEventListener('keydown', (e) => {\n      if (\n        e.ctrlKey &&\n        (e.key === '+' || e.key === '-' || e.key === '=' || e.key === '0')\n      ) {\n        e.preventDefault();\n      }\n    });\n  </script><link rel=\"stylesheet\" href=\"/_astro/map-layout.CEUSWJ-j.css\"><link rel=\"stylesheet\" href=\"/_astro/globals.YdBBm4Z0.css\"></head><body class=\"h-full\"><script src=\"/_astro/maplibre-gl.BKQY
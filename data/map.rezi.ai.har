",\"Kansas, USA\",\"Kansas, United States\",\"Kentucky, US\",\"Kentucky, USA\",\"Kentucky, United States\",\"LA, US\",\"LA, USA\",\"LA, United States\",\"Lafayette County, MS, US\",\"Lafayette County, MS, USA\",\"Lafayette County, MS, United States\",\"Lafayette County, Mississippi, US\",\"Lafayette County, Mississippi, USA\",\"Lafayette County, Mississippi, United States\",\"Laramie County, WY, US\",\"Laramie County, WY, USA\",\"Laramie County, WY, United States\",\"Laramie County, Wyoming, US\",\"Laramie County, Wyoming, USA\",\"Laramie County, Wyoming, United States\",\"Louisiana, US\",\"Louisiana, USA\",\"Louisiana, United States\",\"MA, US\",\"MA, USA\",\"MA, United States\",\"MD, US\",\"MD, USA\",\"MD, United States\",\"ME, US\",\"ME, USA\",\"ME, United States\",\"MI, US\",\"MI, USA\",\"MI, United States\",\"MN, US\",\"MN, USA\",\"MN, United States\",\"MO, US\",\"MO, USA\",\"MO, United States\",\"MS, US\",\"MS, USA\",\"MS, United States\",\"MT, US\",\"MT, USA\",\"MT, United States\",\"Madison County, IN, US\",\"Madison County, IN, USA\",\"Madison County, IN, United States\",\"Madison County, Indiana, US\",\"Madison County, Indiana, USA\",\"Madison County, Indiana, United States\",\"Maine, US\",\"Maine, USA\",\"Maine, United States\",\"Maryland, US\",\"Maryland, USA\",\"Maryland, United States\",\"Massachusetts, US\",\"Massachusetts, USA\",\"Massachusetts, United States\",\"Mercer County, WV, US\",\"Mercer County, WV, USA\",\"Mercer County, WV, United States\",\"Mercer County, West Virginia, US\",\"Mercer County, West Virginia, USA\",\"Mercer County, West Virginia, United States\",\"Michigan, US\",\"Michigan, USA\",\"Michigan, United States\",\"Minnesota, US\",\"Minnesota, USA\",\"Minnesota, United States\",\"Mississippi, US\",\"Mississippi, USA\",\"Mississippi, United States\",\"Missouri, US\",\"Missouri, USA\",\"Missouri, United States\",\"Montana, US\",\"Montana, USA\",\"Montana, United States\",\"Morris County, NJ, US\",\"Morris County, NJ, USA\",\"Morris C
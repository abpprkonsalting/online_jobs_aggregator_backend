# Server
NODE_ENV=development
PORT=3000
DATABASE_URL=mysql://root:password@localhost:3306/map_rezi

# DB dialect
DB_DIALECT=mysql

# DB pool
DB_POOL_LIMIT=10

# Source config
SOURCES_CONFIG_PATH=./config/sources.json
ENABLED_SOURCES=rezi-map

# Polling / scheduling
POLL_INTERVAL_MS=5000
MAX_RETRIES=3
RETRY_DELAY_MS=60000
API_TIMEOUT_MS=30000

# Timeouts
FETCH_TIMEOUT_MS=1800000
STALLED_THRESHOLD_MS=3600000

# Logging
LOG_LEVEL=info
LOG_DIR=./logs
LOGGERS=["console","local"]
CACHE_DIR=./cache

# Auth
JWT_SECRET=change-me-in-production-32-chars-min
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
COOKIE_DOMAIN=

# Admin seed
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe123!

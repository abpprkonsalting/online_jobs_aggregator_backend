# Server
NODE_ENV=development
PORT=3000
DATABASE_URL=mysql://root:password@localhost:3306/map_rezi

# DB dialect
DB_DIALECT=mysql

# DB pool
DB_POOL_LIMIT=10

# Source config
SOURCES_CONFIG_PATH=./config/sources.json
ENABLED_SOURCES=rezi-map

# Polling / scheduling
POLL_INTERVAL_MS=5000
MAX_RETRIES=3
RETRY_DELAY_MS=60000
API_TIMEOUT_MS=30000

# Timeouts
FETCH_TIMEOUT_MS=1800000
STALLED_THRESHOLD_MS=3600000

# Logging
# LOG_LEVEL: debug | info | warn | error
LOG_LEVEL=info
# LOG_DIR: directory where the file logger writes app.log (systemd production sets /var/log/map_rezi)
LOG_DIR=./logs
# LOGGERS: comma-separated or JSON array of targets: "console" (stdout) and/or "local"/"file" (writes ${LOG_DIR}/app.log)
LOGGERS=["console","local"]
CACHE_DIR=./cache

# Auth
JWT_SECRET=change-me-in-production-32-chars-min
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
COOKIE_DOMAIN=

# Admin seed
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe123!

# Google Geocoding API (required to start the API/daemon)
GOOGLE_MAPS_API_KEY=

# Optional notification delivery; comma-separate channel names to enable multiple drivers.
# Gmail: use an App Password (not your normal account password), with 2-Step Verification enabled.
NOTIFICATION_CHANNELS=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=

# Optional AI-powered cross-source job deduplication
OPENAI_API_KEY=
AI_DEDUP_PROVIDER=openai
AI_DEDUP_MODEL=gpt-4o-mini

[Unit]
Description=Map Rezi Background Fetcher Daemon
After=network.target mysql.service map-rezi-api.service

[Service]
Type=simple
User=map_rezi
Group=map_rezi
WorkingDirectory=/var/www/map_rezi/backend
Environment=NODE_ENV=production
Environment=LOG_DIR=/var/log/map_rezi
Environment=CACHE_DIR=/var/lib/map_rezi
ExecStart=/usr/bin/node dist/daemon/index.js
Restart=always
RestartSec=10
StateDirectory=map_rezi
LogsDirectory=map_rezi
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
SyslogIdentifier=map-rezi-fetcher
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
